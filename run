
#!/usr/bin/env bash

set -euo pipefail

# Project root: directory containing this script.
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Require exactly one argument.
if [ "$#" -ne 1 ]; then
    echo "Usage: ./run <ClassName>"
    exit 1
fi

CLASS_NAME="${1%.java}"
SOURCE_DIR="$ROOT_DIR/src"
OUT_DIR="$ROOT_DIR/out"

# Find the requested Java source file.
SOURCE_FILE="$(find "$SOURCE_DIR" \
    -type f \
    -name "${CLASS_NAME}.java" \
    -print -quit)"

if [ -z "$SOURCE_FILE" ]; then
    echo "Error: ${CLASS_NAME}.java was not found in src/."
    exit 1
fi

# Read the Java package declaration.
PACKAGE_NAME="$(sed -n 's/^package[[:space:]]\+\(.*\);/\1/p' \
    "$SOURCE_FILE" | head -n 1)"

# Start with a clean compilation directory.
rm -rf "$OUT_DIR"
mkdir -p "$OUT_DIR"

echo "========================================"
echo "Compiling: $CLASS_NAME"
echo "Source:    ${SOURCE_FILE#"$ROOT_DIR/"}"
echo "========================================"

javac --release 25 -d "$OUT_DIR" "$SOURCE_FILE"

# Determine the fully qualified class name.
if [ -n "$PACKAGE_NAME" ]; then
    MAIN_CLASS="$PACKAGE_NAME.$CLASS_NAME"
else
    MAIN_CLASS="$CLASS_NAME"
fi

echo
echo "Running: $MAIN_CLASS"
echo "----------------------------------------"

java -cp "$OUT_DIR" "$MAIN_CLASS"
